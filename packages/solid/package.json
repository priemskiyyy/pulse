{
  "name": "@priemskiyyy/pulse-solid",
  "version": "0.1.0",
  "description": "Solid bindings for Pulse: a provider, and primitives for the Pulse and its lifecycle state that observe without starting or disposing anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/pulse.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/pulse/issues"
  },
  "homepage": "https://priemskiyyy.github.io/pulse/solid",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project solid"
  },
  "peerDependencies": {
    "@priemskiyyy/pulse": ">=0.1.0 <0.2",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@priemskiyyy/pulse": "workspace:*"
  },
  "keywords": [
    "solid",
    "solidjs",
    "primitives",
    "lifecycle",
    "app-state",
    "page-visibility",
    "foreground",
    "background",
    "pulse"
  ]
}
