{
  "name": "pulse-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && tsc --noEmit -p examples && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:unit",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "test:package": "node scripts/verify-packages.mjs",
    "test:size": "node scripts/measure-size.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:release": "pnpm check && pnpm build:docs && pnpm verify:docs && pnpm verify:snippets && pnpm test:package && pnpm test:size && pnpm verify:release && pnpm test:mutation",
    "test:mutation": "node scripts/mutate.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "build:docs": "vitepress build docs && node scripts/build-demo.mjs",
    "dev:docs": "vitepress dev docs",
    "test:browser": "pnpm build && playwright test -c examples/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "27.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "rolldown": "1.2.11",
    "solid-js": "1.9.15",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42"
  }
}
