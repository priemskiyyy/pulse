{
  "name": "@priemskiyyy/pulse-svelte",
  "version": "0.1.0",
  "description": "Svelte bindings for Pulse: a provider, and utilities for the Pulse and its lifecycle state that observe without starting or disposing anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/pulse.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/pulse/issues"
  },
  "homepage": "https://priemskiyyy.github.io/pulse/svelte",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixture.*",
    "!dist/**/*.contracts.*",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "lint:typescript": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project svelte"
  },
  "peerDependencies": {
    "@priemskiyyy/pulse": ">=0.1.0 <0.2",
    "svelte": ">=5.7.0 <6"
  },
  "devDependencies": {
    "@priemskiyyy/pulse": "workspace:*"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "lifecycle",
    "app-state",
    "page-visibility",
    "foreground",
    "background",
    "pulse"
  ]
}
