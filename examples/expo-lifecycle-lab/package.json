{
  "name": "example-expo-lifecycle-lab",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:native": "expo export --platform ios --platform android --output-dir ../../.artifacts/expo-native",
    "lint:typescript": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@priemskiyyy/pulse": "workspace:*",
    "expo": "57.0.24",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.8.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
